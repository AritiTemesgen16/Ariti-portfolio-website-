# Server-side API key for Resend transactional email delivery
RESEND_API_KEY=

# Destination email address where contact form project inquiries are sent
CONTACT_EMAIL=

# Canonical application URL (production is fixed in the application to https://arititemesgen.com)
APP_URL=https://arititemesgen.com

# Cloudinary persistent profile-photo storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Private owner password for profile-photo management. Never commit the real value.
OWNER_PHOTO_PASSWORD=
